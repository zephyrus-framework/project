{layout layouts/main.latte}

{varType string $frameworkVersion}
{varType string $phpVersion}
{varType string $environment}
{varType array $extensions}
{varType array $database}
{varType array $formatting}

{define check}
    <svg class="w-4 h-4 mr-1 shrink-0 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
    </svg>
{/define}

{define cross}
    <svg class="w-4 h-4 mr-1 shrink-0 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
{/define}

{block title}Zephyrus - Welcome{/block}

{block content}
<div class="min-h-screen flex flex-col">

    {* Header *}
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-4xl mx-auto px-6 py-8 text-center">
            <svg class="w-16 h-16 mx-auto mb-4 text-gray-900" viewBox="0 0 36 36" fill="none" role="img" aria-label="Zephyrus">
                <path d="M5 9h25L7 27h24M5 15h17M14.667 21H31" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <p class="text-gray-500 text-sm">Zephyrus core {$frameworkVersion}</p>
        </div>
    </div>

    {* Main Content *}
    <div class="flex-1">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 py-10">

            {* Welcome *}
            <div class="text-center mb-8">
                <h1 class="text-3xl font-semibold text-gray-900 mb-2">{localize("welcome.title")}</h1>
                <p class="text-gray-500 text-lg">Your application is ready.</p>
            </div>

            {* Getting Started *}
            <div class="bg-white rounded-lg border border-gray-200 p-5 sm:p-6 mb-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Getting Started</h2>
                <div class="space-y-4 text-gray-600 break-words">
                    <div class="flex items-start">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-900 text-white text-xs font-bold mr-3 mt-0.5 shrink-0">1</span>
                        <p class="min-w-0">Edit this page in <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800">app/Views/home.latte</code>; its data comes from <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800">app/<wbr>Controllers/<wbr>HomeController.php</code>.</p>
                    </div>
                    <div class="flex items-start">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-900 text-white text-xs font-bold mr-3 mt-0.5 shrink-0">2</span>
                        <p class="min-w-0">Add a page: put a controller with <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800 whitespace-nowrap">#[Get]</code> or <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800 whitespace-nowrap">#[Post]</code> routes in <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800">app/Controllers/</code> (discovered automatically) and its template in <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800">app/Views/</code>.</p>
                    </div>
                    <div class="flex items-start">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-900 text-white text-xs font-bold mr-3 mt-0.5 shrink-0">3</span>
                        <p class="min-w-0">Keep domain code (models, services, brokers) in <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800">app/Models/</code>.</p>
                    </div>
                    <div class="flex items-start">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-900 text-white text-xs font-bold mr-3 mt-0.5 shrink-0">4</span>
                        <p class="min-w-0">Configure the application, database and mailer in <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800">config.yml</code> and <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800">.env</code>.</p>
                    </div>
                </div>
                <div class="mt-5 pt-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-sm">
                    <a href="https://zephyrus.ophelios.com" class="font-medium text-indigo-700 hover:text-indigo-900 underline underline-offset-2">Read the documentation</a>
                    <span class="text-gray-500">A page answers a bare 500? See "When a Page Fails" in <code class="font-mono text-gray-700 whitespace-nowrap">README.md</code>.</span>
                </div>
            </div>

            {* Status *}
            <div class="bg-white rounded-lg border border-gray-200 p-5 sm:p-6 mb-6 text-sm">
                <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                    {if $environment === 'development'}
                        <span class="inline-flex items-center px-3 py-1 rounded-full font-medium bg-amber-100 text-amber-800">Development</span>
                    {elseif $environment === 'staging' || $environment === 'testing'}
                        <span class="inline-flex items-center px-3 py-1 rounded-full font-medium bg-blue-100 text-blue-800">{$environment|firstUpper}</span>
                    {else}
                        <span class="inline-flex items-center px-3 py-1 rounded-full font-medium bg-green-100 text-green-800">Production</span>
                    {/if}
                    <span class="text-gray-600">PHP <span class="font-mono text-gray-900">{$phpVersion}</span></span>
                    {if $database['connected']}
                        <span class="inline-flex items-center text-gray-600">{include check}PostgreSQL&nbsp;<span class="font-mono text-gray-900">{$database['version']}</span></span>
                    {else}
                        <span class="inline-flex items-center text-red-600">{include cross}Database not connected</span>
                    {/if}
                </div>
                {if !$database['connected']}
                    <p class="mt-2 text-red-600 break-words">{$database['message']}</p>
                {/if}
                <div class="mt-4 pt-3 border-t border-gray-100 flex flex-wrap gap-x-4 gap-y-1">
                    {foreach $extensions as $name => $loaded}
                        <span class="inline-flex items-center font-mono text-xs {$loaded ? 'text-gray-600' : 'text-red-600'}">
                            {if $loaded}{include check}{else}{include cross}{/if}{$name}
                        </span>
                    {/foreach}
                </div>
            </div>

            {* Formatter Showcase *}
            <div class="bg-white rounded-lg border border-gray-200 p-5 sm:p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Formatter</h2>
                <p class="text-gray-500 text-sm mb-4">Locale-aware formatting powered by <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800 whitespace-nowrap">ext-intl</code>. Use the global <code class="bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-gray-800 whitespace-nowrap">format()</code> helper in controllers and templates.</p>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-gray-200">
                                <th class="text-left py-2 pr-4 font-medium text-gray-600">Code</th>
                                <th class="text-left py-2 font-medium text-gray-600">Result</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {foreach $formatting as $example}
                                <tr>
                                    <td class="py-2 pr-4"><code class="text-xs font-mono text-indigo-700 bg-indigo-50 px-1.5 py-0.5 rounded">{$example['code']}</code></td>
                                    <td class="py-2 font-mono text-gray-900">{$example['result']}</td>
                                </tr>
                            {/foreach}
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    {* Footer *}
    <div class="border-t border-gray-200 bg-white">
        <div class="max-w-4xl mx-auto px-6 py-4 text-center text-sm text-gray-400">
            Zephyrus Framework
        </div>
    </div>

</div>
{/block}
