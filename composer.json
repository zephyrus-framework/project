{
    "name": "zephyrus-framework/project",
    "description": "Application template for the Zephyrus PHP framework: Docker-ready with controllers, Latte views, database, sessions, and mailer preconfigured.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "David Tucker",
            "email": "david.tucker@ophelios.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "zephyrus-framework/core": "^3.18"
    },
    "require-dev": {
        "symfony/var-dumper": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "app/Controllers",
            "App\\Models\\": "app/Models"
        }
    },
    "scripts": {
        "post-create-project-cmd": "@php bin/create-env.php"
    },
    "config": {
        "sort-packages": true
    }
}
