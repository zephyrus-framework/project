# Static asset caching
<FilesMatch "\.(ico|pdf|flv|jpe?g|png|gif|js|css|swf|woff2?|ttf|svg)$">
    ExpiresDefault "access plus 2 years"

    FileETag none

    <IfModule mod_headers.c>
        Header unset ETag
        Header unset Cookie
        Header unset Set-Cookie
    </IfModule>
</FilesMatch>

# Front controller - route every request through index.php EXCEPT a file that
# really exists under /assets/ or at /robots.txt, /sitemap.xml or /favicon.ico,
# which Apache serves itself. A missing file or a bare directory there goes to
# the router like any other path, so the application answers it (its own 404, or
# a route that generates the file).
#
# The test is on the decoded path (%{REQUEST_URI}, query string excluded),
# anchored, AND on the file existing. Never test %{THE_REQUEST} for this: it is
# the whole raw request line, so the word "assets" anywhere in a path segment or
# a query value ("/reports/fixed-assets", "?q=assets") would skip the rewrite and
# get Apache's own HTML 404 instead of reaching the application.
#
# The two conditions joined by [OR] read: rewrite unless the path is one of the
# static locations AND names a real file.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/(?:assets/.+|robots\.txt|sitemap\.xml|favicon\.ico)$ [OR]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^/?(.+)/?$ index.php [NC,L,QSA]

# Block direct access to .php files (except index.php)
RewriteCond %{THE_REQUEST} ^.+?\ [^?]+\.php[?\ ]
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteRule ^/?.*\.php$ - [R=404]

# Expiration rules
<IfModule mod_expires.c>
    ExpiresActive on
    ExpiresByType image/x-icon "access plus 2 years"
    ExpiresByType image/ico "access plus 2 years"
    ExpiresByType image/gif "access plus 2 years"
    ExpiresByType image/jpg "access plus 2 years"
    ExpiresByType image/jpeg "access plus 2 years"
    ExpiresByType image/png "access plus 2 years"
    ExpiresByType image/svg+xml "access plus 2 years"
    ExpiresByType font/woff2 "access plus 2 years"
</IfModule>

# Compression
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/x-javascript
AddOutputFilterByType DEFLATE application/json
AddOutputFilterByType DEFLATE image/svg+xml
